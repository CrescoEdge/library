            </exclusion>
            <exclusion>
                <groupId>io.dropwizard.metrics</groupId>
                <artifactId>metrics-core</artifactId>
            </exclusion>
            <!-- quartz: 5.1.33 pulls stock 2.3.2; Cresco declares quartz explicitly below -->
