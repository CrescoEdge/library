    <!-- CEP core engine (transitively pulls siddhi-query-api, siddhi-query-compiler,
         siddhi-annotations, antlr4-runtime, guava, disruptor, snakeyaml). We strip every
         logging backend + the libs Cresco already embeds itself (quartz/json-path/gson/
         metrics) so each is embedded exactly once. Logging is bridged to slf4j below. -->
    <dependency>
        <groupId>io.siddhi</groupId>
        <artifactId>siddhi-core</artifactId>
        <version>${siddhi.version}</version>
        <exclusions>
            <!-- log4j2 (5.1.33) — replaced by slf4j bridge below -->
            <exclusion>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
            </exclusion>
            <exclusion>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
            </exclusion>
            <exclusion>
