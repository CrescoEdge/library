<build>
    <plugins>

        <!-- maven-compiler-plugin configuration (source/target 21) inherited from cresco-parent -->

        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven.javadoc.version}</version>
            <configuration>
                <source>8</source>
                <detectJavaApiLink>false</detectJavaApiLink>
            </configuration>
            <executions>
                <execution>
                    <id>attach-javadocs</id>
                    <phase>package</phase>
                    <goals>
                        <goal>jar</goal>
                    </goals>
                </execution>
            </executions>
        </plugin>

        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven.source.version}</version>
            <executions>
                <execution>
                    <id>attach-sources</id>
                    <phase>package</phase>
                    <goals>
                        <goal>jar-no-fork</goal>
                    </goals>
                </execution>
            </executions>
        </plugin>

        <!-- Produce a log4j-stripped copy of siddhi-core-5.1.33.jar. siddhi-core is a fat
             jar that shades log4j2 (with its OSGi BundleActivators); those trip the bundle
             plugin's activator auto-scan. We remove the shaded log4j here and the bundle
             plugin inlines this clean jar via <Include-Resource>. Runs before packaging. -->
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
                <execution>
                    <id>strip-log4j-from-siddhi-core</id>
                    <phase>process-classes</phase>
                    <goals><goal>run</goal></goals>
                    <configuration>
                        <target>
                            <property name="siddhiJar" value="${settings.localRepository}/io/siddhi/siddhi-core/${siddhi.version}/siddhi-core-${siddhi.version}.jar"/>
                            <delete dir="${project.build.directory}/siddhi-core-unpacked"/>
                            <mkdir dir="${project.build.directory}/siddhi-core-unpacked"/>
                            <unzip src="${siddhiJar}" dest="${project.build.directory}/siddhi-core-unpacked"/>
                            <delete dir="${project.build.directory}/siddhi-core-unpacked/org/apache/logging/log4j"/>
                            <delete dir="${project.build.directory}/siddhi-core-unpacked/org/apache/log4j"/>
                            <delete file="${project.build.directory}/siddhi-core-nolog4j.jar"/>
                            <zip destfile="${project.build.directory}/siddhi-core-nolog4j.jar" basedir="${project.build.directory}/siddhi-core-unpacked"/>
                        </target>
                    </configuration>
                </execution>
            </executions>
        </plugin>

        <plugin>
            <groupId>org.apache.felix</groupId>
            <artifactId>maven-bundle-plugin</artifactId>
            <!-- version + extensions inherited from cresco-parent pluginManagement -->
            <configuration>
                <instructions>
                    <Bundle-SymbolicName>${project.groupId}.${project.artifactId}</Bundle-SymbolicName>
                    <Bundle-Name>Cresco Library</Bundle-Name>
                    <Bundle-Description>Library for Cresco</Bundle-Description>
                    <Bundle-Vendor>Cresco.io</Bundle-Vendor>
                    <Bundle-Version>${project.version}-${maven.build.timestamp}</Bundle-Version>
                    <!--
                      This is the shared uber-bundle: it embeds and re-exports the common
                      runtime (Siddhi, Micrometer, JMS API, etc.) that plugins compile against.
                      The OSGi framework packages are hard requirements (fail-fast if absent);
                      the long tail of optional references inside embedded libraries stays
                      optional so the bundle still resolves without them.
                    -->
                    <Import-Package>
                        org.osgi.framework,
                        org.osgi.framework.*,
                        org.slf4j,
                        org.slf4j.*,
                        *;resolution:=optional
                    </Import-Package>
                    <!-- siddhi-core 5.1.33 is a fat jar that shades log4j2 INCLUDING log4j's
                         OSGi BundleActivator classes. maven-bundle-plugin unconditionally scans
                         embedded deps for BundleActivators and appends them to Bundle-Activator,
                         which then fails ("multiple types"). So siddhi-core is excluded from the
                         embed scan here and instead inlined (below) from a log4j-stripped copy
                         produced by the antrun 'strip-log4j-from-siddhi-core' execution. -->
                    <Embed-Dependency>!org.osgi.*;!slf4j-api;!siddhi-core;*</Embed-Dependency>
                    <!-- inline (@ = explode) the log4j-stripped siddhi-core so io.siddhi.* +
                         its shaded guava/antlr/disruptor are exported per Export-Package. -->
                    <Include-Resource>@${project.build.directory}/siddhi-core-nolog4j.jar</Include-Resource>
                    <_donotcopy>(CVS|\.svn|\.DS_Store|Thumbs\.db|.*org/apache/logging/log4j.*|.*org/apache/log4j.*)</_donotcopy>
                    <Export-Package>
                        io.siddhi.*;
                        org.atteo.classindex.*;
                        com.lmax.disruptor.*;
                        org.antlr.v4.runtime.*;
                        org.quartz.*;
                        com.google.common.*;
                        jakarta.jms.*;
                        com.codahale.metrics.*;
                        org.LatencyUtils;
                        io.micrometer.*;
                        io.cresco.library.*
                    </Export-Package>
                    <!-- Explicit no-op activator: disables bnd auto-detection, which would
                         otherwise find the multiple BundleActivator classes that siddhi-core
                         5.1.33 shades from log4j2 and fail with "multiple types". See NoOpActivator. -->
                    <Bundle-Activator>io.cresco.library.osgi.NoOpActivator</Bundle-Activator>
                    <!-- this bundle has no DS components; do not emit an osgi.component extender requirement -->
                    <_dsannotations></_dsannotations>
                    <!-- two quartz jars on the embed path provide overlapping packages -->
                    <_split-package>merge-first</_split-package>
                </instructions>
            </configuration>
        </plugin>

    </plugins>
</build>

