<properties>
    <!-- jdk, encoding, compiler/bundle plugin versions inherited from cresco-parent -->
    <maven.javadoc.version>3.2.0</maven.javadoc.version>
    <maven.source.version>3.2.1</maven.source.version>
    <micrometer.version>1.12.13</micrometer.version>
    <!-- Siddhi CEP: core engine + the four subprojects (query-api / query-compiler /
         annotations) come transitively with siddhi-core. Extensions are pinned below. -->
    <siddhi.version>5.1.33</siddhi.version>
    <!-- Siddhi 5.1.33 logs via log4j2; the older 5.0.x execution extensions log via the
         log4j 1.x API. We embed NO log4j backend — both APIs are bridged to Cresco's slf4j. -->
    <log4j.version>2.25.4</log4j.version>
</properties>

